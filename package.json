{
  "name": "openpiano-learn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "pnpm --filter @openpiano/web start",
    "dev": "pnpm --filter @openpiano/web dev",
    "build": "pnpm --filter @openpiano/web build",
    "serve": "pnpm --filter @openpiano/web serve",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0"
  }
}
